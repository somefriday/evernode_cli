# Supported values: sync, validator, bash, init
# to temporarily run a container in bash or init mode, set CONTAINER_RUN_MODE=bash before docker-compose command
# i.e.: CONTAINER_RUN_MODE=bash docker-compose up -d
CONTAINER_RUN_MODE=validator
