# https://unicode.org/emoji/charts/full-emoji-list.html
# https://unicode-org.github.io/emoji/emoji/charts-15.0/emoji-list.html
#=================================================
# Text modifiers & signs
export NormText="\e[0m"
export RedBlink="\e[5;101m"
export GreenBack="\e[42m"
export BlueBack="\e[44m"
export RedBack="\e[41m"
export YellowBack="\e[43m"
export BoldText="\e[1m"
Tg_CheckMark=$(echo -e "\U0002705") && export Tg_CheckMark
Tg_SOS_sign=$(echo -e "\U0001F198") && export Tg_SOS_sign
Tg_Warn_sign=$(echo -e "\U000026A0") && export Tg_Warn_sign
Tg_Exclaim_sign=$(echo -e "\U000203C") && export Tg_Exclaim_sign
Tg_Cross_mark=$(echo -e "\U0000274C") && export Tg_Cross_mark
Tg_Heavy_Exclaim=$(echo -e "\U00002757") && export Tg_Heavy_Exclaim
Tg_Error_sign=$(echo -e "\U0002604") && export Tg_Error_sign
