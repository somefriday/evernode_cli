    if Result="$($CALL_CLI -j run --boc "${INPL_ELECTIONS_WORK_DIR}/${Depool_addr##*:}.boc" getParticipantInfo "{\"addr\":\"${Part_addr}\"}" --abi "${INPL_DePool_ABI}")";then
