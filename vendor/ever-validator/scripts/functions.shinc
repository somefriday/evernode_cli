FuncSelfScriptName=functions.shinc

# =====================================================
# Check if env.sh is sourced
if ! $ENV_LOADED;then
    printf "\e[31;1m%b\e[0m\n" "###-ERROR(${FuncSelfScriptName} line $LINENO): env.sh was not sourced successfully. Please, source env.sh first!"
    return 1
fi

#=====================================================
# Function to display error messages with stack trace
function log_error_stack() {
    local i max_src_index message
    message=${1:-"An error occurred."}
    max_src_index=${#BASH_SOURCE[@]}
    echoerr "###-ERROR: $message"

    for (( i=1; i<max_src_index; i++ )); do
        local src="${BASH_SOURCE[$i]}"
        local func="${FUNCNAME[$i]}"
        # BASH_LINENO array is 1-based, but we want to display 1-based line numbers
        # string number refers to the previous function in the call stack
        local line="${BASH_LINENO[$i-1]}"
        printf "  %d: In %s() at %s: %s\n" "$i" "$func" "$src" "$line"
    done
}

# =====================================================
# Check components installed
CURR_CLI_BIN_VERSION="$($CALL_CLI version | head -1 | awk '{print $2}')"
[[ -z $CURR_CLI_BIN_VERSION ]] && log_error_stack "${BoldText}${RedBack}Can not find \"ever-cli\"! Use upd_ever-cli.sh to download or update it or build all binaries by Nodes_Build.sh!!${NormText}" && \
        if [[ "$(basename "$0")" == "bash" || "$(basename "$0")" == "-bash" ]]; then return 1; else exit 1; fi

# =====================================================
# check ever-cli version
# it should be not less MIN_CLI_VERSION settled in env.sh
declare -i CURR_CLI_BIN_VERSION_NUM="1$(echo "$CURR_CLI_BIN_VERSION" | awk -F'.' '{printf("%d%03d%03d%03d\n", $1,$2,$3,$4)}')"
declare -i MIN_CLI_VER_NUM="1$(echo "$MIN_CLI_VERSION" | awk -F'.' '{printf("%d%03d%03d%03d\n", $1,$2,$3,$4)}')"
if [[ ${CURR_CLI_BIN_VERSION_NUM} -lt ${MIN_CLI_VER_NUM#0} ]];then
    echo -e "###-ERROR(${FUNCNAME[1]}-${FUNCNAME[0]} line $LINENO): ${BoldText}${RedBack}CLI version $CURR_CLI_BIN_VERSION is too old! It has to be updated to $MIN_CLI_VERSION at least (use upd_ever-cli.sh)!!!${NormText}"
fi

# =====================================================
# Set appropriate endpoints according network settled in env.sh
NetName="${NETWORK_TYPE%%.*}"
case "$NetName" in
    main | mainnet)
        export DApp_URL="${Main_DApp_URL}/$DAPP_Project_id"
        $CALL_CLI config endpoint reset &>/dev/null || echoerr "###-ERROR(${FuncSelfScriptName} line $LINENO): Can't reset endpoint"
        $CALL_CLI config endpoint add "$NETWORK_TYPE" "$MainNet_DApp_List"  &>/dev/null || echoerr "###-ERROR(${FuncSelfScriptName} line $LINENO): Can't add endpoint"
        $CALL_CLI config --url "$NETWORK_TYPE" &>/dev/null || echoerr "###-ERROR(${FuncSelfScriptName} line $LINENO): Can't set url"
        [[ -n "$DAPP_Project_id" ]] && $CALL_CLI config --project_id "$DAPP_Project_id"   &>/dev/null || echoerr "###-ERROR(${FuncSelfScriptName} line $LINENO): Can't set project_id"
        [[ -n "$DAPP_access_key" ]] && $CALL_CLI config --access_key "$DAPP_access_key"   &>/dev/null || echoerr "###-ERROR(${FuncSelfScriptName} line $LINENO): Can't set access_key"
        export ELECTOR_TYPE="${ELECTOR_TYPE:=fift}"                       # can be 'solidity' or 'fift'
        export GLOBAL_CONFIG_SRC="${CONFIGS_DIR}/mainnet/$NET_GLOBAL_CFG_FILE_NAME"
        ;;
    net | devnet)
        export DApp_URL="${DevNet_DApp_URL}/$DAPP_Project_id"
        $CALL_CLI config endpoint reset &>/dev/null || echoerr "###-ERROR(${FuncSelfScriptName} line $LINENO): Can't reset endpoint"
        $CALL_CLI config endpoint add "$NETWORK_TYPE" "$DevNet_DApp_List"  &>/dev/null || echoerr "###-ERROR(${FuncSelfScriptName} line $LINENO): Can't add endpoint"
        $CALL_CLI config --url "$NETWORK_TYPE"  &>/dev/null || echoerr "###-ERROR(${FuncSelfScriptName} line $LINENO): Can't set url"
        [[ -n "$DAPP_Project_id" ]] && $CALL_CLI config --project_id "$DAPP_Project_id"   &>/dev/null || echoerr "###-ERROR(${FuncSelfScriptName} line $LINENO): Can't set project_id"
        [[ -n "$DAPP_access_key" ]] && $CALL_CLI config --access_key "$DAPP_access_key"   &>/dev/null || echoerr "###-ERROR(${FuncSelfScriptName} line $LINENO): Can't set access_key"
        export ELECTOR_TYPE="${ELECTOR_TYPE:=fift}"                          # can be 'solidity' or 'fift'
        export GLOBAL_CONFIG_SRC="${CONFIGS_DIR}/devnet/$NET_GLOBAL_CFG_FILE_NAME"
        ;;
    *)
        log_error_stack "Unknown NETWORK_TYPE (${NETWORK_TYPE})"
        return 1
        ;;
esac
$CALL_CLI config --lifetime 600 &>/dev/null || log_error_stack "Can't set lifetime in CLI config"

#=================================================
# Get network global id and set ever-cli option if CapSignatureWithId is enabled
# Output: option for ever-cli:
#       - epty string if CapSignatureWithId is disabled
#       - "--signature_id auto" if CapSignatureWithId is enabled
SIG_ID_OPTION=""
NET_GLOBAL_ID=""
# CapSignatureWithId="0x0004000000"
CapSignatureWithId=67108864
if $FORCE_USE_DAPP;then
    if ! CLI_OUTPUT="$(${CALL_CLI} -j getconfig 8)"; then
      log_error_stack " ever-cli getconfig 8 failed"
      log_error_stack "CLI_OUTPUT: $CLI_OUTPUT"
      return 1
    fi
    NetCaps=$(printf "%d" "0x$(echo "${CLI_OUTPUT}" | jq -r '.capabilities' | cut -d 'x' -f 2)")
    # We cannot get global_id from ever-cli, so we will use auto
    SIG_ID_OPTION="--signature_id auto"
else
    if ! NET_GLOBAL_ID=$(${CALL_CONS} -jc getstatsnew | jq .global_id); then
      log_error_stack "console getstatsnew failed"
      return 1
    fi
    if ! CONS_OUTPUT="$(${CALL_CONS} -jc 'getconfig 8')"; then
      log_error_stack "console getconfig 8 failed"
      log_error_stack "CONS_OUTPUT: $CONS_OUTPUT"
      return 1
    fi
    NetCaps=$(echo "${CONS_OUTPUT}" | jq -r '.p8.capabilities_dec')
    SIG_ID_OPTION="--signature_id=$NET_GLOBAL_ID"
fi
# Set SIG_ID_OPTION according to CapSignatureWithId
if [[ $((NetCaps & CapSignatureWithId)) -eq 0 ]]; then
  SIG_ID_OPTION=""
  NET_GLOBAL_ID=""
fi
export NET_GLOBAL_ID
export SIG_ID_OPTION

# =====================================================
# Determine current network
function Determine_Current_Network() {
    # get current network zerostate
    case "${NETWORK_TYPE%%.*}" in
        main)
            CURR_NET_ID="$MAIN_NET_ROOT_HASH"
            ;;
        net | devnet)
            CURR_NET_ID="$DEV_NET_ROOT_HASH"
            ;;

        *)
            CURR_NET_ID="123456789ABCDEF0"
            ;;
    esac
    case "${CURR_NET_ID}" in
        "$MAIN_NET_ROOT_HASH")
            CurrNetInfo="${BoldText}${BlueBack}You are in MAIN network${NormText}"
            ;;
        "$DEV_NET_ROOT_HASH")
            CurrNetInfo="${BoldText}${GreenBack}You are in DEVNET network${NormText}"
            ;;
        *)
            CurrNetInfo="${BoldText}${RedBlink}You are in UNKNOWN network${NormText} or you need to update 'env.sh'"
            ;;
    esac
    echo "${CurrNetInfo}" 
}
# =====================================================
function DispEnvInfo() {
    Repo="$(git config --get remote.origin.url|sed 's/.*\///; s/.git//')"
    echo "INFO from env: Repo: $Repo; Network: $NETWORK_TYPE; WC: $NODE_WC; Elector: $ELECTOR_TYPE; Staking mode: $STAKE_MODE; Access method: $(if $FORCE_USE_DAPP;then echo "DApp"; else  echo "console"; fi ); RUN mode: $RUN_MODE"
}
# =====================================================
function hex2dec() {
    local ival="$(echo "${1^^}"|tr -d '"')"
    local ob=${2:-10}
    local ib=${3:-16}
    if [[ -z "$ival" ]] || ! [[ "$ival" =~ ^[0-9A-F]+$ ]]; then
        log_error_stack "Invalid hexadecimal input."
        echo ""
        return 1
    fi
    if [[ "$OS_SYSTEM" == "Linux" ]];then
        export BC_LINE_LENGTH=0
        # set obase first before ibase -- or weird things happen.
        printf "obase=%d; ibase=%d; %s\n" "$ob" "$ib" "$ival" | bc
    else
        dc -e "${ib}i ${ival} p" | tr -d "\\" | tr -d "\n"
    fi
}
# =====================================================
function dec2hex() {
    local ival="${1^^}"
    local ob=${2:-16}
    local ib=${3:-10}
    if [[ -z "$ival" ]] || ! [[ "$ival" =~ ^[0-9]+$ ]]; then
        log_error_stack "Invalid decimal input."
        echo ""
        return 1
    fi
    if [[ "$OS_SYSTEM" == "Linux" ]];then
        export BC_LINE_LENGTH=0
        # set obase first before ibase -- or weird things happen.
        printf "obase=%d; ibase=%d; %s\n" "$ob" "$ib" "$ival" | bc
    else
        dc -e "64z ${ib}i ${ob}o ${ival} p" | tr -d "\\" | tr -d '\n'
    fi
}
# =====================================================
function TD_unix2human() {
    local ival="${1//\"/}"
    if [[ -z $ival ]]; then
        log_error_stack "Zero Time"
        return 1
    fi
    if ! [[ "$ival" =~ ^[0-9]+$ ]]; then
        log_error_stack "Invalid Unix timestamp."
        return 1
    fi
    if [[ "$OS_SYSTEM" == "Linux" ]];then
        date  +'%F %T %Z' -d "@$ival"
    else
        date -r "$ival" +'%F %T %Z'
    fi
}
#=================================================
# Get current Time Diff
function Get_TimeDiff() { 
    local RC_OUTPUT=$($CALL_CONS -jc "getstatsnew" 2>&1 | cat)
    if echo "$RC_OUTPUT" | grep -q 'Connection refused\|panicked at'; then
        echo "Node Down"
        return 1
    fi
    if echo "$RC_OUTPUT" | grep -iq 'error'; then
        echo "Error"
        return 2
    fi
    # statuses:
    # https://github.com/everx-labs/ever-node/blob/e1c321bf3aef765554c3caa43e0bd417bb4ba14d/src/network/control.rs#L183
    local StatusKey="sync_status"
    local STATUS="$(jq -r ".$StatusKey" <<< "$RC_OUTPUT"|cat)"
    [[ "$STATUS" == "null" ]] && StatusKey="node_status"
    STATUS="$(jq -r ".$StatusKey" <<< "$RC_OUTPUT"|cat)"

    if [[ "$(jq -r ".$StatusKey" <<< "$RC_OUTPUT")" == "db_broken" ]];then
        echo "db_broken"
        return 3
    fi
    if echo "${RC_OUTPUT}" | grep -q 'timediff';then
        local MC_TIME_DIFF SH_TIME_DIFF VALIDATION
        MC_TIME_DIFF=$(jq -r '.timediff' <<< "$RC_OUTPUT")
        SH_TIME_DIFF=$(jq -r '.shards_timediff' <<< "$RC_OUTPUT")
        VALIDATION=$(jq -r '.validation_status' <<< "$RC_OUTPUT")
        echo "$MC_TIME_DIFF $SH_TIME_DIFF $STATUS $VALIDATION"
    else
        echo "$STATUS"
    fi
} # Get_TimeDiff
#=================================================
# Get ellector address
function Get_Elector_Address() {
    local elector_addr=""
    if $FORCE_USE_DAPP ;then
        elector_addr="$($CALL_CLI -j getconfig 1 | tr -d '"')"
    else
        elector_addr="$($CALL_CONS -jc 'getconfig 1' | jq -r '.p1')"
    fi
    if [[ -z $elector_addr ]]; then
        log_error_stack "Can not get Elector Address!!!"
        return 1
    fi
    echo "-1:${elector_addr}"
} # Get_Elector_Address
#=================================================
# Get Smart Contract current state by dowloading it & save to file
function Get_SC_current_state() {
    # Input: acc in form x:xxx...xxx
    # result: file named xxx...xxx.boc in TMP_DIR or in current folder if TMP_DIR is not set
    # return: Output of executing
    local ACCOUNT="$1"
    if [[ -z "$ACCOUNT" ]]; then
        log_error_stack "Empty address"
        return 1
    fi
    # account hex
    local s_acc="${ACCOUNT##*:}"
    # account workchain
    local acc_wc="${ACCOUNT%%:*}"
    if $FORCE_USE_DAPP; then
        for (( Try=0; Try <= 5; Try++ )); do
            rm -f "${ELECTIONS_WORK_DIR}/${s_acc}.boc"
            local LC_OUTPUT="$($CALL_CLI account "$ACCOUNT" --dumpboc "${INPL_ELECTIONS_WORK_DIR}/${s_acc}.boc")"
            [[ -f "${ELECTIONS_WORK_DIR}/${s_acc}.boc" ]] && local result="written StateInit of account" && break
            sleep 3
        done
    else
        NODE_WC="0"
        if [[ "${NODE_WC}" == "${acc_wc}" ]] || [[ "${acc_wc}" == "-1" ]];then
            for (( Try=0; Try <= 5; Try++ ))
            do
                rm -f "${ELECTIONS_WORK_DIR}/${s_acc}.boc"
                local LC_OUTPUT="$($CALL_CONS -c "getaccountstate ${ACCOUNT} ${INPL_ELECTIONS_WORK_DIR}/${s_acc}.boc")"
                [[ -f "${ELECTIONS_WORK_DIR}/${s_acc}.boc" ]] && local result="written StateInit of account" && break
                sleep 3
            done
        else
            # The node can only obtain acc status from WC where it is and master, so use ever-cli
            for (( Try=0; Try <= 5; Try++ ))
            do
                rm -f "${ELECTIONS_WORK_DIR}/${s_acc}.boc"
                local LC_OUTPUT="$($CALL_CLI account "$ACCOUNT" --dumpboc "${INPL_ELECTIONS_WORK_DIR}/${s_acc}.boc")"
                [[ -f "${ELECTIONS_WORK_DIR}/${s_acc}.boc" ]] && local result="written StateInit of account" && break
                sleep 3
            done
        fi
    fi
    if [[ -z  $result ]]; then
        log_error_stack "Cannot get account state $ACCOUNT."
        echoerr "${LC_OUTPUT}"
        return 1
    else
        echo "${result}"
    fi
}
#=================================================
# Detect current elector type in the network
function Get_Current_Elector_Type() {
    local elector_addr="$(Get_Elector_Address)"
    result=$(Get_SC_current_state "${elector_addr}")
    if [[  "$result" != "written StateInit of account" ]];then
        log_error_stack "Cannot get Elector state!"
        return 1
    fi
    local ELECTOR_TYPE="unknown"
    FUNC_TC_OUT="$($CALL_CLI runget --boc "${INPL_ELECTIONS_WORK_DIR}/${elector_addr##*:}.boc" active_election_id 2>&1| grep 'unknown error'|cat)"
    SOL_TC_OUT="$($CALL_CLI -j run --boc "${INPL_ELECTIONS_WORK_DIR}/${elector_addr##*:}.boc" active_election_id '{}' --abi "${INPL_Elector_ABI}" 2>&1|grep 'unknown error'|cat)"
    
    if [[ -n $FUNC_TC_OUT ]] && [[ -z $SOL_TC_OUT ]];then
        export ELECTOR_TYPE="solidity"
    elif [[ -z $FUNC_TC_OUT ]] && [[ -n $SOL_TC_OUT ]];then
        export ELECTOR_TYPE="fift"
    fi
    if [[ "$ELECTOR_TYPE" == "unknown" ]];then
        log_error_stack "Cannot determine Elector type!"
        return 2
    fi
    if ! $KEEP_TMP_DIR ;then rm -rf "${TMP_DIR}" &>/dev/null; fi
    echo "$elector_addr $ELECTOR_TYPE"
}
#=================================================;;
# Get current elections ID
function Get_Current_Elections_ID() {
    if result=$(Get_Current_Elector_Type);then
        read -r elector_addr ELECTOR_TYPE <<< "$result"
    else
        log_error_stack "Cannot get Elector type!"
        return 1
    fi
    local elections_id="0"
    case "${ELECTOR_TYPE}" in
        "fift")
            if ! elections_id=$($CALL_CLI -j runget --boc "${INPL_ELECTIONS_WORK_DIR}/${elector_addr##*:}.boc" active_election_id);then
                log_error_stack "Error getting elections ID for fift Elector"
                echo "$elections_id"
                return 2
            fi
            elections_id=$(jq -r '.value0' <<< "$elections_id")
            ;;
        "solidity")
            if ! elections_id=$($CALL_CLI -j run --boc "${INPL_ELECTIONS_WORK_DIR}/${elector_addr##*:}.boc" active_election_id '{}' --abi "${INPL_Elector_ABI}");then
                log_error_stack "Error getting elections ID for solidity Elector"
                echo "$elections_id"
                return 3
            fi
            elections_id=$(jq -r '.value0' <<< "$elections_id")
            ;;
        *)
            log_error_stack "Unknown ELECTOR_TYPE (${ELECTOR_TYPE})"
            return 4
            ;;
    esac
    echo "${elections_id}"
}
#=================================================
## @fn get_LastNodeInfo()
## @brief Fetches the latest node information from a specified smart contract.
## @details This function retrieves the last node information from the smart contract defined by LNIC_ADDRESS.
## It verifies if the LNIC_ADDRESS is not empty and checks the account state to ensure it's "Active".
## If the conditions are met, it proceeds to fetch and decode the smart contract's current state.
## This includes retrieving the ABI for the contract to extract the last node information.
##
## Upon successful retrieval, the function prints the last node info extracted from the contract.
## If any step fails, an error message is printed, indicating the failure reason.
##
## The function utilizes a temporary directory for storing intermediate files.
## If the optional argument "keep TMP_DIR" is provided, the temporary files will not be deleted after execution.
##
## @param none No parameters are required directly, but LNIC_ADDRESS should be defined in env.sh.
## @retval Prints the last node information on success or an error message on failure.
function get_LastNodeInfo {
    local LNI_JSON="none"
    # check LNIC_ADDRESS
    if [[ -z "$LNIC_ADDRESS" ]];then
        log_error_stack "LNIC_ADDRESS is empty!"
        echo "${LNI_JSON}"
        return 1
    fi
    # check LNIC_ADDRESS state
    if [[ "$(Get_Account_Info "$LNIC_ADDRESS" | awk '{print $1}')" != "Active" ]];then
        log_error_stack "LNIC account not found."
        echo "${LNI_JSON}"
        return 2
    fi
    #
    if ! Get_SC_current_state "$LNIC_ADDRESS" > /dev/null; then
        log_error_stack "Error getting LNIC state."
        echo "${LNI_JSON}"
        return 3
    fi

    local ABI="${ELECTIONS_WORK_DIR}/LastNodeInfo.abi.json"
    local INPL_ABI="${INPL_ELECTIONS_WORK_DIR}/LastNodeInfo.abi.json"

    # Fixed ABI for getABI function
    local GetABI=$(jq -n '{
      "ABI version": 2,
      "version": "2.2",
      "header": ["time", "expire"],
      "functions": [
        {"name": "getABI", "inputs": [], "outputs": [{"name": "ABI_hex", "type": "string"}]},
        {"name": "ABI", "inputs": [], "outputs": [{"name": "ABI_hex", "type": "string"}]}
      ],
      "data": [],
      "events": [],
      "fields": [{"name": "ABI_hex", "type": "string"}]
    }')

    local GetABIFile="${ELECTIONS_WORK_DIR}/Get_ABI.json"
    local INPL_GetABIFile="${INPL_ELECTIONS_WORK_DIR}/Get_ABI.json"

    # Создание файла Get_ABI.json на хосте
    echo "$GetABI" > "${GetABIFile}"

    local LNIC_ABI_hex="${ELECTIONS_WORK_DIR}/LNIC_ABI_hex.txt"
    local LNIC_ABI_bin="${ELECTIONS_WORK_DIR}/LNIC_ABI.bin"

    # get LNIC ABI HEX from contract state
    $CALL_CLI -j run --boc "${INPL_ELECTIONS_WORK_DIR}/${LNIC_ADDRESS##*:}.boc" \
        --abi "${INPL_GetABIFile}" getABI {} | \
        jq -r '.ABI_hex' > "${LNIC_ABI_hex}"
    # decode LNIC ABI from HEX to binary
    if ! xxd -r -p "${LNIC_ABI_hex}" > "${LNIC_ABI_bin}"; then
        log_error_stack "Failed to decode LNIC ABI from HEX to binary"
        return 4
    fi
    # Read magic bytes to determine compression format
    local MAGIC_BYTES
    MAGIC_BYTES=$(head -c6 "${LNIC_ABI_bin}" | xxd -p)
    # Determine compression format and extract ABI
    if [[ "$MAGIC_BYTES" == "fd377a585a00" ]]; then
        # xz compressed file
        if ! xz -d "${LNIC_ABI_bin}" -c > "${ABI}"; then
            log_error_stack "Failed to decompress LNIC ABI using xz"
            return 5
        fi
    elif [[ "$MAGIC_BYTES" == "377abcaf271c" ]]; then
        # 7z compressed file
        if ! 7za x -y "${LNIC_ABI_bin}" -o"${ELECTIONS_WORK_DIR}" > /dev/null 2>&1; then
            log_error_stack "Failed to decompress LNIC ABI using 7z"
            return 5
        fi
    elif [[ "$MAGIC_BYTES" == "504b0304" ]]; then
        # zip compressed file
        if ! unzip -o "${LNIC_ABI_bin}" -d "${ELECTIONS_WORK_DIR}" > /dev/null 2>&1; then
            log_error_stack "Failed to decompress LNIC ABI using unzip"
            return 5
        fi
    elif [[ "$MAGIC_BYTES" == "1f8b0800" ]]; then
        # gzip compressed file
        if ! gzip -d -c "${LNIC_ABI_bin}" > "${ABI}"; then
            log_error_stack "Failed to decompress LNIC ABI using gzip"
            return 5
        fi
    elif [[ "$MAGIC_BYTES" == "425a68" ]]; then
        # bzip2 compressed file
        if ! bzip2 -d -c "${LNIC_ABI_bin}" > "${ABI}"; then
            log_error_stack "Failed to decompress LNIC ABI using bzip2"
            return 5
        fi
    elif [[ "$(head -c13 "${LNIC_ABI_bin}")xx" == '{"ABI versionxx' ]]; then
        # none compressed file
        cp "${LNIC_ABI_bin}" "${ABI}"
    else
        log_error_stack "Unknown compression format in LNIC ABI. Magic bytes: $MAGIC_BYTES"
        return 6
    fi
    # check if ABI file exists
    if [[ ! -e "${ABI}" ]]; then
        log_error_stack "Cannot get LNIC ABI from contract boc"
        echo "${LNI_JSON}"
        return 7
    fi
    # get last node info from contract
    LNI_JSON="$($CALL_CLI -j run --boc "${INPL_ELECTIONS_WORK_DIR}/${LNIC_ADDRESS##*:}.boc" --abi "${INPL_ABI}" curr_node_info {})"
    # Extract last node info from JSON
    local LNI_Info
    LNI_Info="$(jq -r '.curr_node_info' <<< "$LNI_JSON"  2>/dev/null)"
    if [[ -z "$LNI_Info" ]] || [[ "$LNI_Info" == "null" ]]; then
        log_error_stack "Last node info from contract is empty."
        echo "${LNI_JSON}"
        return 8
    fi
    echo "$LNI_Info"
}

#=================================================
# Get supported blocks versions from node and network
# Input: 
# Return: Net_Min_Sup_Blk NodeGit_Sup_Blk NodeBin_Sup_Blk NodeRun_Version
#   - Net_Min_Sup_Blk - from network config
#   - NodeGit_Sup_Blk - from local git repo
#   - NodeBin_Sup_Blk - from binary file ($CALL_NODE -V)
#   - NodeRun_Version - Node version received from the running service via the console (in text - "0.51.27")
function Get_Supported_Blocks_Version() {
    local -i Net_Min_Sup_Blk=0
    local -i NodeGit_Sup_Blk=0
    local -i NodeBin_Sup_Blk=0
    local NodeRun_Version="0"
    # get net supported_block
    if $FORCE_USE_DAPP ;then
        Net_Min_Sup_Blk=$($CALL_CLI -j getconfig 8 | jq -r '.version'|cat)
    else
        Net_Min_Sup_Blk=$($CALL_CONS -jc 'getconfig 8' | jq '.p8.version'|cat)
    fi
    if [[ $Net_Min_Sup_Blk -le 0 ]];then
        log_error_stack "Cannot get network supported block version!!!"
        return 1
    fi
    # get Git supported_block
    NodeGit_Sup_Blk=$(awk '/pub fn supported_version/ {getline;print $1}' "${NODE_SRC_DIR}/src/validating_utils.rs")
    # get supported_block from binary
    NodeBin_Sup_Blk=$(. ./env.sh && ${CALL_NODE%% *} -V | grep 'BLOCK_VERSION:' | awk '{print $2}')
    local RC_OUT=$($CALL_CONS -jc getstats 2>/dev/null | cat | jq -r '.node_version' 2>/dev/null | cat)
    if [[ -n $RC_OUT ]] && [[ "$RC_OUT" != "null" ]];then
        NodeRun_Version=$RC_OUT
    fi
    echo "${Net_Min_Sup_Blk} ${NodeGit_Sup_Blk} ${NodeBin_Sup_Blk} ${NodeRun_Version}"
}

#=================================================
# Get account INFO
# Input: AccountHEX
# Return: Active/Uninit/None nanoTokens LastOperTime
function Get_Account_Info() {
    local ACCOUNT=$(echo "$1"| tr '[:upper:]' '[:lower:]')
    local acc_wc=${ACCOUNT%%:*}
    local acc_hex=${ACCOUNT##*:}
    if [[ ${#acc_hex} -ne 64 ]];then
        log_error_stack "Wrong account address!"
        echo "None 0 0" 
        return 1
    fi
    if $FORCE_USE_DAPP ;then
        local ACCOUNT_INFO=$($CALL_CLI -j account "${ACCOUNT}" 2>&1 | jq . 2>/dev/null)
        if echo "$ACCOUNT_INFO" |grep -q '{}';then
            echo "None 0 0"
            return
        fi
        local AMOUNT_nt=$(jq -r ".balance" <<< "$ACCOUNT_INFO")
        local LASTOP=$(jq -r ".last_paid" <<< "$ACCOUNT_INFO")
        local STATUS=$(jq -r ".acc_type" <<< "$ACCOUNT_INFO")
    else
        if [[ "${NODE_WC}" == "${acc_wc}" ]] || [[ "${acc_wc}" == "-1" ]];then
            local ACCOUNT_INFO=$($CALL_CONS -j -c "getaccount $ACCOUNT")
            if echo "${ACCOUNT_INFO}" | grep -iq 'Nonexist' || echo "${ACCOUNT_INFO}" | grep -iq 'Error';then
                echo "None 0 0"
                return
            fi
        else
            local ACCOUNT_INFO=$($CALL_CLI -j account "${ACCOUNT}" 2>&1 | jq .)
            if echo "${ACCOUNT_INFO}" | grep -iq '{}';then
                echo "None 0 0"
                return
            fi
        fi
        local AMOUNT_nt=$(jq -r '.balance' <<< "$ACCOUNT_INFO")
        local LASTOP=$(jq -r '.last_paid' <<< "$ACCOUNT_INFO")
        local STATUS=$(jq -r '.acc_type' <<< "$ACCOUNT_INFO")
    fi
    echo "${STATUS} ${AMOUNT_nt} ${LASTOP}"
}
#=================================================
# Get account Custodians
# Input: AccountHEX
# Return: NumOfCustodians MinNumOfConfirmations
function Get_Account_Custodians_Info() {
    local ACCOUNT=$1
    local Custod_QTY=0
    local Confirms_QTY=0
    if ! result="$(Get_SC_current_state "$ACCOUNT")";then
        log_error_stack "Cannot get account state $ACCOUNT. Can't continue. Sorry."
        return 1
    fi
    if [[ ! -f "${ELECTIONS_WORK_DIR}/${ACCOUNT##*:}.boc" ]];then
        log_error_stack "Cannot find account boc file ${ELECTIONS_WORK_DIR}/${ACCOUNT##*:}.boc"
        return 2
    fi
    local ACC_BOC="${INPL_ELECTIONS_WORK_DIR}/${ACCOUNT##*:}.boc"
    Custod_QTY=$($CALL_CLI   -j run --boc "${ACC_BOC}" getCustodians '{}' --abi "${INPL_SafeC_Wallet_ABI}" | jq -r '.custodians|length')
    Confirms_QTY=$($CALL_CLI -j run --boc "${ACC_BOC}" getParameters '{}' --abi "${INPL_SafeC_Wallet_ABI}" | jq -r '.requiredTxnConfirms')
    echo "${Custod_QTY} ${Confirms_QTY}"
}
#=================================================
# Search ADNL in Network config 34
# Input: ADNL_HEX
# Return: 
#   "PUBKEY WEIGHT" - if ADNL found in p34 list
#   "absent" - if not found
#   "null" - if p34 is empty
function P34_ADNL_search() {
    local Result="absent"
    local ADNL=$(echo "$1"| tr '[:upper:]' '[:lower:]')
    if [[ ${#ADNL} -ne 64 ]];then
        echo "${Result}"
        return
    fi
    if $FORCE_USE_DAPP ;then
        local P34_List="$($CALL_CLI -j getconfig 34)"
        if echo "$P34_List" | grep -q '{}';then
            echo "null"
            return
        fi
    else
        local P34_List="$($CALL_CONS -jc "getconfig 34")"
        if echo "$P34_List" | grep -q '{}';then
            echo "null"
            return
        fi
    fi
    local found="$(jq ".p34.list[]|select(.adnl_addr == \"$ADNL\")" <<< "${P34_List}")"
    if [[ -n $found ]]; then
        local pkey="$(jq -r .public_key <<< "${found}")"
        local wght="$(jq -r .weight <<< "${found}")"
        Result="${pkey} ${wght}"
    fi
    echo "${Result}"
}
#=================================================
# Search ADNL in Network config 36
# Input: ADNL_HEX
# Return: 
#   "PUBKEY WEIGHT" - if ADNL found in p36 list
#   "absent" - if not found
#   "null" - if p36 is empty
function P36_ADNL_search() {
    local Result="absent"
    local ADNL=$(echo "$1"| tr '[:upper:]' '[:lower:]'| tr -d '"')
    if [[ ${#ADNL} -ne 64 ]];then
        echo "${Result}"
        return
    fi
    if $FORCE_USE_DAPP ;then
        local P36_List="$($CALL_CLI -j getconfig 36)"
        if echo "$P36_List" | grep -q '{}';then
            echo "null"
            return
        fi
        local found=$(jq ".list[]|select(.adnl_addr == \"$ADNL\")" <<< "${P36_List}")
    else
        local P36_List="$($CALL_CONS -jc "getconfig 36")"   # | jq '.p36')"
        if echo "$P36_List" | grep -q '{}';then
            echo "null"
            return
        fi
        local found=$(jq ".p36.list[]|select(.adnl_addr == \"$ADNL\")" <<< "${P36_List}")
    fi
    if [[ -n $found ]]; then
        local pkey="$(jq -r .public_key <<< "${found}")"
        local wght="$(jq -r .weight_dec <<< "${found}")"
        Result="${pkey} ${wght}"
    fi
    echo "${Result}"
}
#=================================================
# Get current Engine keys
# Returns: 
#   null    - if have not participated in any elections yet
#   CurrADNL Curr_ID - if only one elections in engine (CPP node before elections or first elections for Rust node)
#   CurrADNL Curr_ID Next_ADNL Next_ID - in other cases
# Current - keys for current validating round
# Next - keys for next validating round (after success bid for elections)
function Get_Engine_ADNL() {
    local Result="null"
    if ! local Curr_Engine_Val_Keys="$(jq .validator_keys "${NODE_CFG_DIR}/config.json")";then
        log_error_stack "Cannot get Engine keys from ${NODE_CFG_DIR}/config.json"
        return 1
    fi
    [[ "$Curr_Engine_Val_Keys" == "null" ]] && echo "$Result" && return
    local ADNL_0="$(jq -r .[0].validator_adnl_key_id <<< "$Curr_Engine_Val_Keys")"
    local Elec_0="$(jq -r .[0].election_id <<< "$Curr_Engine_Val_Keys")"
    local ADNL_1="$(jq -r .[1].validator_adnl_key_id <<< "$Curr_Engine_Val_Keys")"
    local Elec_1="$(jq -r .[1].election_id <<< "$Curr_Engine_Val_Keys")"
    if [[ "$ADNL_0" == "null" ]];then
        echo "$Result"
        return
    fi
    if [[ "$ADNL_1" == "null" ]];then
        local Curr_Engine_ADNL="$(echo "$ADNL_0" | base64 -d | xxd -p | tr -d '\n')"
        local Curr_Engine_Elec_ID=$Elec_0
    else
        local Next_Engine_Elec_ID="$((Elec_0 > Elec_1 ? Elec_0 : Elec_1))"
        local Curr_Engine_Elec_ID="$((Elec_0 < Elec_1 ? Elec_0 : Elec_1))"
        local Curr_Engine_ADNL="$(echo "$Curr_Engine_Val_Keys" | jq -r ".[]|select(.election_id == $Curr_Engine_Elec_ID)|.validator_adnl_key_id" \
            | base64 -d|od -t xC -An|tr -d '\n'|tr -d ' ')"
        local Next_Engine_ADNL="$(echo "$Curr_Engine_Val_Keys" | jq -r ".[]|select(.election_id == $Next_Engine_Elec_ID)|.validator_adnl_key_id" \
            | base64 -d|od -t xC -An|tr -d '\n'|tr -d ' ')"
    fi
    if [[ -z $ADNL_1 ]] || [[ "$ADNL_1" == "null" ]];then
        Result="${Curr_Engine_ADNL} ${Curr_Engine_Elec_ID}"
    else
        Result="${Curr_Engine_ADNL} ${Curr_Engine_Elec_ID} ${Next_Engine_ADNL} ${Next_Engine_Elec_ID}"
    fi
    echo "$Result"
}
#=================================================
# Search ADNL in Elector during elections
# Input: ADNL in HEX format
# Return: 
#   "absent" - if not found
#   "null" - if elections closed
#   "stake time max_factor addr" - if found
function Elector_ADNL_Search() {
    local ERR_WRONG_ADNL_LENGTH=1
    local ERR_ELECTOR_TYPE=2
    local ERR_ELECTIONS_CLOSED=3
    local ERR_ADNL_ABSENT=4
    local ERR_UNKNOWN_ELECTOR_TYPE=5
    local Result="absent"
    local Elector_Parts_List=""
    local Elections_Open=""
    local LC_OUTPUT=""
    local ADNL=$(echo "$1"| tr '[:upper:]' '[:lower:]'| tr -d '"')
    if [[ ${#ADNL} -ne 64 ]];then
        echo "Wrong ADNL address"
        return $ERR_WRONG_ADNL_LENGTH
    fi
    # boc file with current elector state will be saved in ${ELECTIONS_WORK_DIR}/${elector_addr##*:}.boc
    if result=$(Get_Current_Elector_Type);then
        read -r elector_addr ELECTOR_TYPE <<< "$result"
    else
        log_error_stack "Cannot get Elector type!"
        return $ERR_ELECTOR_TYPE
    fi
    NET_ELECTOR_BOC="${INPL_ELECTIONS_WORK_DIR}/${elector_addr##*:}.boc"
    case "${ELECTOR_TYPE}" in
        fift)
            local Elector_Parts_List="$($CALL_CLI runget --boc "${NET_ELECTOR_BOC}" participant_list_extended | grep -i 'result:' | tr "]]" "\n" | tr '[' '\n' | awk 'NF > 0'| tr '","' ' ')"
            local Elections_Open=$(echo "$Elector_Parts_List" | grep -F '0 0 0 0 null 0 0')
            if [[ -n $Elections_Open ]];then
                echo "null"
                return $ERR_ELECTIONS_CLOSED
            fi
            local found=$(echo "${Elector_Parts_List}" | grep -i "0x${ADNL}")
            if [[ -z $found ]];then
                echo "absent"
                return $ERR_ADNL_ABSENT
            fi
            local stake=$(echo "${found}" | awk '{print $1}')
            local time=0
            local max_factor=$(echo "${found}" | awk '{print $2}')
            local addr="$(echo "${Elector_Parts_List}" | grep -B 1 "0x${ADNL}" | head -1|cut -d 'x' -f 2)"
            Result="$stake $time $max_factor $addr"
            ;;
        solidity)
            local Elector_Parts_List=$($CALL_CLI -j run --boc "${NET_ELECTOR_BOC}" get '{}' --abi "${INPL_Elector_ABI}")
            local Elections_Open=$(jq -r .election_open <<< "${Elector_Parts_List}")
            if [[ $Elections_Open -eq 0 ]]; then
                echo "null"
                return $ERR_ELECTIONS_CLOSED
            fi
            local found=$(jq ".cur_elect.members[]|select(.adnl_addr == \"0x${ADNL}\")" <<< "${Elector_Parts_List}")
            if [[ -z $found ]];then
                echo "absent"
                return $ERR_ADNL_ABSENT
            fi
            local      stake="$(jq -r .stake <<< "${found}")"
            local       time="$(jq -r .time <<< "${found}")"
            local max_factor="$(jq -r .max_factor <<< "${found}")"
            local       addr="$(jq -r .addr <<< "${found}" |cut -d 'x' -f 2)"
            Result="$stake $time $max_factor $addr"
            ;;
        *)
            log_error_stack "unknown ELECTOR_TYPE (${ELECTOR_TYPE})"
            return $ERR_UNKNOWN_ELECTOR_TYPE
            ;;
    esac
    echo "${Result}"
}
#=================================================
# Get network config 15
# Output:
#   validators_elected_for elections_start_before elections_end_before stake_held_for
#
function Get_NetConfig_P15() {
    local Result=""
    if $FORCE_USE_DAPP ;then
        if ! local CONFIG_PAR_15="$($CALL_CLI -j getconfig 15)"; then
            log_error_stack "Get network election params (p15) FAILED!!!"
            return 1
        fi
    else
        if ! local CONFIG_PAR_15="$($CALL_CONS -j -c "getconfig 15" | jq '.p15')"; then
            log_error_stack "Get network election params (p15) FAILED!!!"
            return 2
        fi
    fi
    local validators_elected_for="$(jq -r '.validators_elected_for'  <<< "$CONFIG_PAR_15")"
    local elections_start_before="$(jq -r '.elections_start_before'  <<< "$CONFIG_PAR_15")"
    local   elections_end_before="$(jq -r '.elections_end_before'    <<< "$CONFIG_PAR_15")"
    local         stake_held_for="$(jq -r '.stake_held_for'          <<< "$CONFIG_PAR_15")"
    if [[ -z $validators_elected_for ]] || [[ -z $elections_start_before ]] || [[ -z $elections_end_before ]] || [[ -z $stake_held_for ]];then
        log_error_stack "Get network election params (p15) is empty!!!"
        return 3
    fi
    Result="$validators_elected_for $elections_start_before $elections_end_before $stake_held_for"
    echo "${Result}"
}
#=================================================
# Get DePool rounds
# Input: DePool_Addr
# Output: DePool Rounds in json format
function Get_DP_Rounds() {
    local Result=""
    local Depool_addr="$1"
    if [[ ! -f $DePool_ABI ]];then
        log_error_stack "Cannot find DePool ABI. Can't continue. Sorry."
        return 1
    fi
    if ! Get_SC_current_state "$Depool_addr" | grep -iq "written StateInit of account";then
        log_error_stack "Cannot get DePool state!! $Depool_addr"
        return 2
    fi
    Result="$($CALL_CLI -j run --boc "${INPL_ELECTIONS_WORK_DIR}/${Depool_addr##*:}.boc" getRounds '{}' --abi "$INPL_DePool_ABI")"

    echo "${Result}"
}
#=================================================
# echo "$(Rounds_Sorting_by_ID "$Curr_Rounds_Info")"
# Input 
#   "rounds_in_json"
# Output
#   "sorted_rounds_in_json"
function Rounds_Sorting_by_ID() {
    local Rounds_json=$1
    local ID0=$(jq -r "[.rounds[]]|.[0].id" <<< "$Rounds_json")
    local ID1=$(jq -r "[.rounds[]]|.[1].id" <<< "$Rounds_json")
    local ID2=$(jq -r "[.rounds[]]|.[2].id" <<< "$Rounds_json")
    local ID3=$(jq -r "[.rounds[]]|.[3].id" <<< "$Rounds_json")
    declare -a rounds=($((ID0)) $((ID1)) $((ID2)) $((ID3)))
    # shellcheck disable=SC918,SC2207
    IFS=$'\n' Rounds_Sorted=($(sort -g <<<"${rounds[*]}")); unset IFS
    local RS_0="$(jq -r "[.rounds[]]|.[]|select(.id == \"${Rounds_Sorted[0]}\")" <<< "$Rounds_json")"
    local RS_1="$(jq -r "[.rounds[]]|.[]|select(.id == \"${Rounds_Sorted[1]}\")" <<< "$Rounds_json")"
    local RS_2="$(jq -r "[.rounds[]]|.[]|select(.id == \"${Rounds_Sorted[2]}\")" <<< "$Rounds_json")"
    local RS_3="$(jq -r "[.rounds[]]|.[]|select(.id == \"${Rounds_Sorted[3]}\")" <<< "$Rounds_json")"
    echo "[${RS_0},${RS_1},${RS_2},${RS_3}]"
}
#=================================================
# Get depool elections ID
# Input: DePool_Addr
# Output: DePool_elections_ID
function Get_DePool_elec_ID() {
    local Depool_addr="$1"
    local Depool_Rounds_Info="$(Get_DP_Rounds "$Depool_addr")"
    local Curr_Rounds_Info="$(Rounds_Sorting_by_ID "$Depool_Rounds_Info")"
    local Curr_DP_Elec_ID=$(jq -r ".[1].supposedElectedAt" <<< "$Curr_Rounds_Info" | xargs printf "%10d\n")
    echo "$Curr_DP_Elec_ID"
}
#=================================================
# Get DePool Self balance
#   Input: DePool_Addr
#   Output: DePool self balance in Tokens XXX.XXX
function Get_DP_Self_Balance() {
    local Result=""
    local Depool_addr="$1"
    if ! Get_SC_current_state "$Depool_addr" | grep -iq "written StateInit of account";then
        log_error_stack "Cannot get DePool state!! $Depool_addr"
        return 1
    fi
    DP_balance_nT="$($CALL_CLI -j run --boc "${INPL_ELECTIONS_WORK_DIR}/${Depool_addr##*:}.boc" getDePoolBalance '{}' --abi "${INPL_DePool_ABI}" | jq -r '.value0')"
    Result="$(echo "scale=3; $((DP_balance_nT)) / 1000000000" | $CALL_BC)"
    echo "${Result}"
}
#=================================================
# Get DePool INFO
# Input: DePool_Addr
# Output: DePool Info in json format
# see depool info in depool ABI in 
#    contracts/EverX/depool/DePool.abi.json
# or contracts/Broxus/StEver/DePool.abi.json
function Get_DP_Info() {
    local Result=""
    local Depool_addr="$1"
    if ! Get_SC_current_state "$Depool_addr" | grep -iq "written StateInit of account";then
        log_error_stack "Cannot get DePool state!! $Depool_addr"
        return 1
    fi
    Result="$($CALL_CLI -j run --boc "${INPL_ELECTIONS_WORK_DIR}/${Depool_addr##*:}.boc" getDePoolInfo '{}' --abi "${INPL_DePool_ABI}")"
    if echo "$Result" | grep -qi 'Failed';then
        log_error_stack "Cannot get DePool info!!!"
        echoerr "$Result"
        echoerr "Do you have right path to  DePool's abi?"
        return 2
    fi
    echo "${Result}"
}
#=================================================
# Get DePool List of Partisipants 
# Input: DePool_Addr
# Output: DePool Info in json format
function Get_DP_Parts_List() {
    local Result=""
    local Depool_addr="$1"
    if ! Get_SC_current_state "$Depool_addr" | grep -iq "written StateInit of account";then
        log_error_stack "Cannot get DePool state!! $Depool_addr"
        return 1
    fi
    if Result="$($CALL_CLI -j run --boc "${INPL_ELECTIONS_WORK_DIR}/${Depool_addr##*:}.boc" getParticipants '{}' --abi "${INPL_DePool_ABI}")";then
        echo "${Result}"
        return 0
    else
        log_error_stack "Cannot get DePool Partisipants list! It seems that DePool is empty."
        echo "${Result}"
        return 2
    fi
}
#=================================================
# Get DePool Partisipant Info
# Input: DePool_Addr Part_Addr
# Output: DePool Partisipant Info in json format
function Get_DP_Part_Info() {
    local Result=""
    local Depool_addr="$1"
