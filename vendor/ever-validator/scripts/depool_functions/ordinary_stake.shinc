#**************************************************************************************************
# NB! This script is a part of the main script and is called from there. It cannot be run separately.
# Some variables are defined in the main script and are used here.
#**************************************************************************************************

function make_ordinary_stake() {
    local Depool_addr="$1"
    local MSIG_NAME="$2"
    local STAKE_AMOUNT=$3     # in tokens

    #=================================================
    # check if all variables are set
    if [[ -z $Depool_addr ]] || [[ -z $MSIG_NAME ]] || [[ -z $STAKE_AMOUNT ]];then
        echoerr "###-ERROR(${FUNCNAME[0]} line $LINENO): Not all input variables are set. Exiting..."
        return 1
    fi
    STAKE_AMOUNT_NANO=$(echo "$STAKE_AMOUNT * 1000000000" | $CALL_BC|cut -d '.' -f 1)
    if [[ $STAKE_AMOUNT_NANO -lt 100000 ]];then
        echoerr "###-ERROR(${FUNCNAME[0]} line $LINENO): Can't transfer too small amount of nanotokens! (${STAKE_AMOUNT_NANO})nt"
        return 1
    fi
    # shellcheck disable=SC2154
    if [[ $MSIG_AMOUNT -lt $((STAKE_AMOUNT_NANO  + 1000000000)) ]];then
        echoerr "###-ERROR(${FUNCNAME[0]} line $LINENO): The stake amount $STAKE_AMOUNT is more than the MSIG balance $MSIG_AMOUNT_Tk + 1. Exiting..."
        return 1
    fi

    local MSIG_addr=$(cat "${KEYS_DIR}/${MSIG_NAME}.addr")

    #=================================================
    # check depool min stake
    # shellcheck disable=SC2154
    Depool_Min_Stake=$(jq -r '.minStake | tonumber / 1000000000' <<< "${Current_Depool_Info}")
    if [[ $STAKE_AMOUNT -lt $Depool_Min_Stake ]];then
        echoerr "###-ERROR(${FUNCNAME[0]} line $LINENO): Stake amount $STAKE_AMOUNT is less than the minimum stake $Depool_Min_Stake. Exiting..."
        return 1
    fi

    printf "\n%s\n\n" "You want to make an ordinary stake $STAKE_AMOUNT for the multisig $MSIG_NAME in the depool $Depool_addr"
    #=================================================
    read -rp "### CHECK INFO TWICE!!! Are you sure you want to proceed? (y/n)? " </dev/tty answer
    case ${answer} in
        y|Y|yes|Yes|YES )
            printf "%s\n" "Processing..."
        ;;
        * )
            printf "%s\n" "Cancelled."
            return 1
        ;;
    esac

    #=================================================
    # make ordinary stake
    # shellcheck disable=SC2154
    local PayLoad="$($CALL_CLI -j body --abi "${INPL_DePool_ABI}" addOrdinaryStake "{\"stake\":$STAKE_AMOUNT_NANO}"|jq -r '.Message')"
    # shellcheck disable=SC2154
    $CALL_CLI message --raw --output "${INPL_ELECTIONS_WORK_DIR}/stakeOrdinary.boc" \
        --sign "${INPL_KEYS_DIR}/${MSIG_NAME}_1.keys.json" ${SIG_ID_OPTION} \
        --abi "${INPL_SafeC_Wallet_ABI}" \
        "${MSIG_addr}" submitTransaction \
        "{\"dest\":\"$Depool_addr\",\"value\":$((STAKE_AMOUNT_NANO + DEPOOL_STAKE_FEE_NANO)),\"bounce\":true,\"allBalance\":false,\"payload\":\"$PayLoad\"}" \
        --lifetime 3600
    # Decode BOC file
    if ! Message_JSON="$($CALL_CLI -j decode msg --abi "${INPL_SafeC_Wallet_ABI}" "${INPL_ELECTIONS_WORK_DIR}/stakeOrdinary.boc")";then
        echoerr "###-ERROR(${FUNCNAME[0]} line $LINENO): Cannot decode message for stakeOrdinary.boc. Exiting..."
        echoerr "$Message_JSON"
        return 1
    fi
    # Check the message body
    # Convert the binary stakeOrdinary.boc to base64
    BodyBase64="$(jq -r '.Body' <<< "$Message_JSON")"
    if ! OUTPUT="$($CALL_CLI decode body --abi "${INPL_SafeC_Wallet_ABI}" "${BodyBase64}")";then
        echoerr "###-ERROR(${FUNCNAME[0]} line $LINENO): Cannot decode body for stakeOrdinary.boc. Exiting..."
        echoerr "$OUTPUT"
        return 1
    fi
    #################
    if ! New_Trans_ID=$(Send_Message "${MSIG_addr}" "${Depool_addr}" "${INPL_ELECTIONS_WORK_DIR}/stakeOrdinary.boc");then
    #################
        return 1
    else
        # shellcheck disable=SC2154
        if [[ $Required_Signs -gt 1 ]];then
            printf "%s\n" "+++-INFO: Made transaction ID: $New_Trans_ID . You need to sign it with the remaining keys by run ${BoldText} ./Sign_Trans.sh $MSIG_NAME $New_Trans_ID ${NormText}"
        else
            printf "%s\n" "+++-INFO: Set ordinary stake successfull. You can check in the depool by ./dinfo.sh script."
        fi
    fi
    return 0
}
